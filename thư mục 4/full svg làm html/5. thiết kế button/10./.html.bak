<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Liquid Metal Capsule Button · Premium Animated</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: #03060c;
            overflow: hidden;
        }

        /* ===== BACKGROUND ===== */
        .bg-svg {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100dvh;
            z-index: 0;
            pointer-events: none;
            display: block;
        }

        .stage {
            position: relative;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            width: 100%;
        }

        /* ===== BUTTON – "LIQUID METAL CAPSULE" ===== */
        /* Logic: Capsule Button (giữ dạng viên nang).
           Ý tưởng mới: Kim loại lỏng (Mercury). Bề mặt trơn bóng, phản chiếu.
           Có một giọt kim loại nhỏ (droplet) ở góc. 
           Hover: Giọt kim loại "chảy" dọc theo viền, bề mặt sáng bóng hơn.
           Active: Bề mặt "gợn sóng" (ripple 3D) và tối lại. */
        .liq-metal-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 1.1rem 3rem 1.1rem 2.5rem;
            border: none;
            background: transparent;
            cursor: pointer;
            font-family: inherit;
            font-weight: 700;
            font-size: clamp(0.95rem, 3vw, 1.15rem);
            letter-spacing: 0.12em;
            color: #0a1018; /* Chữ tối để tương phản với nền kim loại sáng */
            text-transform: uppercase;
            border-radius: 999px;
            -webkit-tap-highlight-color: transparent;
            isolation: isolate;
            transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
            will-change: transform;
            box-shadow: 0 15px 35px -10px rgba(0,0,0,0.8);
        }

        /* Bề mặt kim loại lỏng (Mercury) */
        .liq-metal-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: 
                /* Highlight trên cùng */
                radial-gradient(ellipse 120% 50% at 50% 0%, rgba(255, 255, 255, 1) 0%, transparent 60%),
                /* Phản chiếu môi trường */
                radial-gradient(ellipse 80% 100% at 80% 50%, rgba(200, 220, 240, 0.8) 0%, transparent 60%),
                /* Dải màu kim loại */
                linear-gradient(180deg, 
                    #d0d8e8 0%, 
                    #90a4c0 20%, 
                    #4a5a70 45%, 
                    #2a3648 55%, 
                    #6a7a90 80%, 
                    #b0c0d8 100%);
            box-shadow:
                0 0 0 1px rgba(255, 255, 255, 0.6) inset,
                0 1px 0 rgba(255, 255, 255, 0.9) inset,
                0 -1px 0 rgba(0, 0, 0, 0.6) inset,
                0 0 20px rgba(0, 0, 0, 0.4) inset;
            z-index: -2;
            transition: filter 0.4s ease;
        }

        /* Lớp phủ bóng bẩy (Specular) */
        .liq-metal-btn::after {
            content: '';
            position: absolute;
            top: 3px;
            left: 10%;
            right: 10%;
            height: 30%;
            border-radius: 999px;
            background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0));
            pointer-events: none;
            z-index: -1;
            opacity: 0.8;
        }

        /* Giọt kim loại lỏng (Droplet) */
        .droplet {
            position: absolute;
            top: -4px;
            left: 20%;
            width: 12px;
            height: 12px;
            border-radius: 50% 50% 50% 0; /* Hình giọt nước */
            background: linear-gradient(135deg, #ffffff, #90a4c0);
            box-shadow: 
                0 0 0 1px rgba(255, 255, 255, 0.8) inset,
                0 2px 4px rgba(0, 0, 0, 0.5);
            transform: rotate(-45deg);
            z-index: 5;
            transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            will-change: transform, left, top;
        }

        /* SVG Ripple gợn sóng (Dùng khi Active) */
        .ripple-layer {
            position: absolute;
            inset: 0;
            border-radius: inherit;
            overflow: hidden;
            z-index: -1;
            pointer-events: none;
        }
        .ripple-svg {
            width: 100%;
            height: 100%;
            display: block;
        }
        .ripple-circle {
            fill: none;
            stroke: rgba(255, 255, 255, 0.8);
            stroke-width: 2;
            opacity: 0;
            transform-origin: center;
        }

        /* LABEL */
        .btn-label {
            position: relative;
            z-index: 5;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            text-shadow: 0 1px 0 rgba(255,255,255,0.5); /* Chữ nổi trên nền kim loại */
        }

        /* Icon: Giọt nước / Kim loại */
        .drop-icon {
            display: inline-flex;
            width: 0.85em;
            height: 0.85em;
            transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            will-change: transform;
        }
        .drop-icon svg { width: 100%; height: 100%; display: block; }

        /* ===== HOVER ===== */
        @media (hover: hover) {
            .liq-metal-btn:hover {
                transform: translateY(-2px) scale(1.02);
            }
            .liq-metal-btn:hover::before {
                filter: brightness(1.2) contrast(1.1);
            }
            /* Giọt kim loại trượt dọc viền */
            .liq-metal-btn:hover .droplet {
                left: 80%;
                top: -6px;
                transform: rotate(-135deg) scale(0.8);
            }
            .liq-metal-btn:hover .drop-icon {
                transform: translateY(-2px) scale(1.1);
            }
        }

        /* ===== ACTIVE ===== */
        .liq-metal-btn:active {
            transform: scale(0.95);
            transition: transform 0.08s ease;
            box-shadow: 0 5px 15px -5px rgba(0,0,0,0.8);
        }
        .liq-metal-btn:active::before {
            filter: brightness(0.8);
        }
        /* Kích hoạt hiệu ứng gợn sóng (Ripple) */
        .liq-metal-btn:active .ripple-circle {
            animation: liquidRipple 0.6s ease-out forwards;
        }
        @keyframes liquidRipple {
            0%   { transform: scale(0); opacity: 1; }
            100% { transform: scale(1.5); opacity: 0; }
        }
        /* Giọt kim loại bắn ra */
        .liq-metal-btn:active .droplet {
            transform: rotate(-45deg) scale(1.5);
            opacity: 0;
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            .liq-metal-btn, .liq-metal-btn::before, .droplet, .drop-icon {
                transition-duration: 0.01ms !important;
            }
            .liq-metal-btn:hover .droplet { left: 20%; top: -4px; transform: rotate(-45deg); }
            .liq-metal-btn:active .ripple-circle { animation: none; opacity: 0; }
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 480px) {
            .liq-metal-btn {
                padding: 0.9rem 2.4rem 0.9rem 2rem;
                font-size: 0.85rem;
                letter-spacing: 0.1em;
            }
            .droplet { width: 10px; height: 10px; }
        }
    </style>
</head>
<body>

    <!-- ============ BACKGROUND SVG ============ -->
    <!-- Phong cách: Phòng thí nghiệm tối, ánh sáng từ trên, các đường nét kỹ thuật mờ -->
    <svg class="bg-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
            <radialGradient id="labBg" cx="50%" cy="20%" r="100%">
                <stop offset="0%"   stop-color="#121a24"/>
                <stop offset="40%"  stop-color="#080c12"/>
                <stop offset="100%" stop-color="#020406"/>
            </radialGradient>

            <radialGradient id="lamp" cx="50%" cy="0%" r="60%">
                <stop offset="0%"   stop-color="#ffffff" stop-opacity="0.15"/>
                <stop offset="50%"  stop-color="#90a4c0" stop-opacity="0.05"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
            </radialGradient>

            <linearGradient id="techLine" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%"   stop-color="#90a4c0" stop-opacity="0.05"/>
                <stop offset="50%"  stop-color="#c0d0e0" stop-opacity="0.15"/>
                <stop offset="100%" stop-color="#90a4c0" stop-opacity="0.05"/>
            </linearGradient>
        </defs>

        <rect width="1440" height="900" fill="url(#labBg)"/>
        <rect width="1440" height="900" fill="url(#lamp)"/>

        <!-- Lưới kỹ thuật (Technical grid) -->
        <g opacity="0.15" stroke="url(#techLine)" stroke-width="1">
            <line x1="0" y1="225" x2="1440" y2="225"/>
            <line x1="0" y1="450" x2="1440" y2="450"/>
            <line x1="0" y1="675" x2="1440" y2="675"/>
            <line x1="360" y1="0" x2="360" y2="900"/>
            <line x1="720" y1="0" x2="720" y2="900"/>
            <line x1="1080" y1="0" x2="1080" y2="900"/>
        </g>

        <!-- Vòng tròn kỹ thuật -->
        <g opacity="0.1" fill="none" stroke="#90a4c0" stroke-width="1">
            <circle cx="720" cy="450" r="200" />
            <circle cx="720" cy="450" r="400" stroke-dasharray="5 15"/>
        </g>

        <!-- Điểm nút (Nodes) -->
        <g fill="#c0d0e0" opacity="0.3">
            <circle cx="360" cy="225" r="2" />
            <circle cx="1080" cy="225" r="2" />
            <circle cx="360" cy="675" r="2" />
            <circle cx="1080" cy="675" r="2" />
            <circle cx="720" cy="450" r="3" />
        </g>
    </svg>

    <!-- ============ STAGE ============ -->
    <div class="stage">
        <button class="liq-metal-btn" aria-label="Khám phá">
            
            <!-- Giọt kim loại lỏng -->
            <span class="droplet" aria-hidden="true"></span>

            <!-- Lớp gợn sóng khi Active -->
            <span class="ripple-layer" aria-hidden="true">
                <svg class="ripple-svg" viewBox="0 0 300 80" preserveAspectRatio="none">
                    <ellipse class="ripple-circle" cx="150" cy="40" rx="10" ry="10" />
                </svg>
            </span>

            <!-- LABEL -->
            <span class="btn-label">
                Khám phá
                <span class="drop-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <!-- Giọt nước / Kim loại -->
                        <path d="M12 2 C 8 9 5 13 5 16 A 7 7 0 0 0 19 16 C 19 13 16 9 12 2 Z" 
                              fill="#6a7a90" stroke="#ffffff" stroke-width="1" stroke-linejoin="round"/>
                        <!-- Highlight bóng -->
                        <path d="M9 12 C 9 12 8 15 10 16" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" opacity="0.8"/>
                    </svg>
                </span>
            </span>
        </button>
    </div>

</body>
</html>