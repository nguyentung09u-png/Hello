<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Prism Split Button · Premium Animated</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: #030711;
            overflow: hidden;
        }

        /* ===== BACKGROUND ===== */
        .bg-svg {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100dvh;
            z-index: 0;
            pointer-events: none;
            display: block;
        }

        .stage {
            position: relative;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            width: 100%;
        }

        /* ===== BUTTON – "PRISM SPLIT" ===== */
        /* Ý tưởng: button hình thoi (diamond) bị chẻ dọc giữa, 2 nửa trượt
           ra 2 bên khi hover, hé lộ tia sáng lăng kính ở giữa. */
        .prism-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            border: none;
            background: transparent;
            cursor: pointer;
            font-family: inherit;
            color: #eef6ff;
            -webkit-tap-highlight-color: transparent;
            isolation: isolate;
            /* hình thoi rộng */
            width: clamp(200px, 42vw, 280px);
            height: clamp(64px, 10vw, 80px);
            transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        }

        /* Hai nửa hình thoi */
        .half {
            position: absolute;
            top: 0;
            height: 100%;
            width: 50%;
            transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
                        filter 0.4s ease;
            z-index: 2;
            will-change: transform;
        }

        /* Nửa trái: hình tam giác bên trái của hình thoi */
        .half.left {
            left: 0;
            clip-path: polygon(0% 50%, 100% 0%, 100% 100%);
        }
        .half.left::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 90% 120% at 90% 40%, rgba(180, 220, 255, 0.55), transparent 55%),
                linear-gradient(135deg,
                    #4a8fff 0%,
                    #2a5cd8 25%,
                    #14327a 60%,
                    #0a1a44 100%);
            box-shadow:
                0 0 0 1px rgba(160, 200, 255, 0.4) inset,
                -8px 10px 26px -8px rgba(0, 30, 100, 0.9);
            clip-path: inherit;
            filter: brightness(1);
            transition: filter 0.4s ease;
        }
        .half.left::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(220, 240, 255, 0.35), transparent 55%);
            clip-path: inherit;
            mix-blend-mode: overlay;
            pointer-events: none;
        }

        /* Nửa phải */
        .half.right {
            right: 0;
            clip-path: polygon(0% 0%, 100% 50%, 0% 100%);
        }
        .half.right::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 90% 120% at 10% 40%, rgba(180, 220, 255, 0.55), transparent 55%),
                linear-gradient(225deg,
                    #4a8fff 0%,
                    #2a5cd8 25%,
                    #14327a 60%,
                    #0a1a44 100%);
            box-shadow:
                0 0 0 1px rgba(160, 200, 255, 0.4) inset,
                8px 10px 26px -8px rgba(0, 30, 100, 0.9);
            clip-path: inherit;
            transition: filter 0.4s ease;
        }
        .half.right::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(225deg, rgba(220, 240, 255, 0.35), transparent 55%);
            clip-path: inherit;
            mix-blend-mode: overlay;
            pointer-events: none;
        }

        /* Tia sáng lăng kính ở giữa (giữa 2 nửa) */
        .prism-core {
            position: absolute;
            top: 8%;
            bottom: 8%;
            left: 50%;
            width: 2px;
            transform: translateX(-50%);
            background: linear-gradient(180deg,
                transparent 0%,
                rgba(220, 240, 255, 0.9) 25%,
                rgba(160, 210, 255, 1) 50%,
                rgba(220, 240, 255, 0.9) 75%,
                transparent 100%);
            box-shadow: 0 0 12px rgba(180, 220, 255, 0.9),
                        0 0 24px rgba(110, 170, 255, 0.6);
            z-index: 1;
            opacity: 0.9;
            transition: opacity 0.35s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
            pointer-events: none;
        }

        /* SVG "prism rays" – phát tia khi hover */
        .prism-rays {
            position: absolute;
            inset: -30%;
            z-index: 0;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.5s ease;
        }
        .prism-rays svg {
            width: 100%;
            height: 100%;
            display: block;
            overflow: visible;
        }

        /* LABEL */
        .btn-label {
            position: relative;
            z-index: 5;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            font-weight: 700;
            font-size: clamp(0.92rem, 3vw, 1.15rem);
            letter-spacing: 0.14em;
            text-transform: uppercase;
            text-shadow: 0 2px 10px rgba(0, 10, 40, 0.85),
                         0 0 20px rgba(120, 180, 255, 0.4);
            transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
                        text-shadow 0.4s ease;
            will-change: transform;
        }

        /* Icon: hình thoi nhỏ xoay */
        .glyph {
            display: inline-flex;
            width: 0.85em;
            height: 0.85em;
            transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .glyph svg { width: 100%; height: 100%; display: block; }

        /* ===== HOVER ===== */
        @media (hover: hover) {
            .prism-btn:hover {
                transform: translateY(-2px);
            }
            .prism-btn:hover .half.left {
                transform: translateX(-22%);
            }
            .prism-btn:hover .half.right {
                transform: translateX(22%);
            }
            .prism-btn:hover .half.left::before,
            .prism-btn:hover .half.right::before {
                filter: brightness(1.18);
            }
            .prism-btn:hover .prism-core {
                opacity: 1;
                transform: translateX(-50%) scaleY(1.08);
            }
            .prism-btn:hover .prism-rays {
                opacity: 1;
            }
            .prism-btn:hover .btn-label {
                transform: scale(1.03);
                text-shadow: 0 2px 12px rgba(0, 10, 40, 0.95),
                             0 0 24px rgba(150, 200, 255, 0.7);
            }
            .prism-btn:hover .glyph {
                transform: rotate(180deg);
            }
        }

        /* ===== ACTIVE ===== */
        .prism-btn:active {
            transform: translateY(0) scale(0.97);
            transition: transform 0.08s ease;
        }
        .prism-btn:active .half.left {
            transform: translateX(-10%);
        }
        .prism-btn:active .half.right {
            transform: translateX(10%);
        }
        .prism-btn:active .btn-label {
            transform: scale(0.97);
        }
        .prism-btn:active .half.left::before,
        .prism-btn:active .half.right::before {
            filter: brightness(0.82);
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            .half, .btn-label, .glyph, .prism-core, .prism-rays {
                transition-duration: 0.01ms !important;
            }
            .prism-btn:hover .half.left { transform: translateX(-8%); }
            .prism-btn:hover .half.right { transform: translateX(8%); }
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 480px) {
            .prism-btn {
                width: 75vw;
                height: 60px;
            }
            .btn-label {
                font-size: 0.85rem;
                letter-spacing: 0.1em;
            }
        }
    </style>
</head>
<body>

    <!-- ============ BACKGROUND SVG ============ -->
    <!-- Phong cách: không gian lăng kính – tia sáng xiên, một tâm sáng góc trên trái -->
    <svg class="bg-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
            <radialGradient id="bgBase" cx="22%" cy="18%" r="100%">
                <stop offset="0%"   stop-color="#0f2550"/>
                <stop offset="35%"  stop-color="#071634"/>
                <stop offset="70%"  stop-color="#020b1e"/>
                <stop offset="100%" stop-color="#01030a"/>
            </radialGradient>

            <radialGradient id="lamp" cx="22%" cy="18%" r="60%">
                <stop offset="0%"   stop-color="#ffffff" stop-opacity="0.18"/>
                <stop offset="40%"  stop-color="#a8d0ff" stop-opacity="0.08"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
            </radialGradient>

            <!-- Gradient cho tia sáng xiên -->
            <linearGradient id="rayFar" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%"   stop-color="#6aa8ff" stop-opacity="0.30"/>
                <stop offset="45%"  stop-color="#2a5cd8" stop-opacity="0.14"/>
                <stop offset="100%" stop-color="#041034" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="rayMid" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%"   stop-color="#a8d0ff" stop-opacity="0.28"/>
                <stop offset="55%"  stop-color="#3a7aff" stop-opacity="0.12"/>
                <stop offset="100%" stop-color="#020716" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="rayNear" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%"   stop-color="#ffffff" stop-opacity="0.22"/>
                <stop offset="60%"  stop-color="#6aa8ff" stop-opacity="0.10"/>
                <stop offset="100%" stop-color="#02060f" stop-opacity="0"/>
            </linearGradient>

            <!-- Blur theo khoảng cách -->
            <filter id="blurFar" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="10"/>
            </filter>
            <filter id="blurMid" x="-25%" y="-25%" width="150%" height="150%">
                <feGaussianBlur stdDeviation="4"/>
            </filter>
            <filter id="glowSoft" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="3" result="b"/>
                <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
        </defs>

        <rect width="1440" height="900" fill="url(#bgBase)"/>
        <rect width="1440" height="900" fill="url(#lamp)"/>

        <!-- FAR: tia sáng xiên rộng, mờ -->
        <g opacity="0.7" filter="url(#blurFar)">
            <polygon points="0,0 400,0 200,900 0,900" fill="url(#rayFar)"/>
            <polygon points="320,0 520,0 380,900 220,900" fill="url(#rayFar)" opacity="0.6"/>
        </g>

        <!-- MID: tia sáng hẹp hơn -->
        <g opacity="0.85" filter="url(#blurMid)">
            <polygon points="900,0 1000,0 780,900 700,900" fill="url(#rayMid)"/>
            <polygon points="1140,0 1200,0 1000,900 940,900" fill="url(#rayMid)" opacity="0.7"/>
            <polygon points="620,0 680,0 540,900 490,900" fill="url(#rayMid)" opacity="0.5"/>
        </g>

        <!-- NEAR: đường sáng mảnh, sắc -->
        <g opacity="0.9">
            <line x1="120" y1="0" x2="-80" y2="900" stroke="url(#rayNear)" stroke-width="1.2"
                  filter="url(#glowSoft)"/>
            <line x1="1080" y1="0" x2="900" y2="900" stroke="url(#rayNear)" stroke-width="1.4"
                  filter="url(#glowSoft)">
                <animate attributeName="opacity" values="0.6;1;0.6" dur="6s" repeatCount="indefinite"/>
            </line>
            <line x1="1320" y1="0" x2="1160" y2="900" stroke="url(#rayNear)" stroke-width="0.9"
                  filter="url(#glowSoft)"/>
        </g>

        <!-- Tâm sáng nhấp nháy -->
        <g>
            <circle cx="1260" cy="180" r="3.5" fill="#dbeaff" filter="url(#glowSoft)">
                <animate attributeName="opacity" values="0;1;0" dur="5.5s" repeatCount="indefinite"/>
                <animate attributeName="r" values="2.4;4;2.4" dur="5.5s" repeatCount="indefinite"/>
            </circle>
            <circle cx="320" cy="640" r="2.2" fill="#a8ccff" filter="url(#glowSoft)">
                <animate attributeName="opacity" values="0;1;0" dur="7.2s" repeatCount="indefinite"/>
            </circle>
            <circle cx="820" cy="760" r="2.6" fill="#e0f0ff" filter="url(#glowSoft)">
                <animate attributeName="opacity" values="0;1;0" dur="9.4s" repeatCount="indefinite"/>
            </circle>
        </g>

        <!-- Lưới mảnh, tạo chiều sâu -->
        <g opacity="0.06" stroke="#7fb4ff" stroke-width="0.5">
            <line x1="0" y1="225" x2="1440" y2="225"/>
            <line x1="0" y1="450" x2="1440" y2="450"/>
            <line x1="0" y1="675" x2="1440" y2="675"/>
            <line x1="360" y1="0" x2="360" y2="900"/>
            <line x1="720" y1="0" x2="720" y2="900"/>
            <line x1="1080" y1="0" x2="1080" y2="900"/>
        </g>
    </svg>

    <!-- ============ STAGE ============ -->
    <div class="stage">
        <button class="prism-btn" aria-label="Khám phá">
            <!-- Tia sáng lăng kính bung ra khi hover -->
            <span class="prism-rays" aria-hidden="true">
                <svg viewBox="0 0 400 200" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="rayBurst" x1="0%" y1="50%" x2="100%" y2="50%">
                            <stop offset="0%"   stop-color="#ffffff" stop-opacity="0.9"/>
                            <stop offset="100%" stop-color="#6aa8ff" stop-opacity="0"/>
                        </linearGradient>
                        <linearGradient id="rayBurst2" x1="100%" y1="50%" x2="0%" y2="50%">
                            <stop offset="0%"   stop-color="#ffffff" stop-opacity="0.9"/>
                            <stop offset="100%" stop-color="#6aa8ff" stop-opacity="0"/>
                        </linearGradient>
                        <filter id="rayGlow" x="-20%" y="-200%" width="140%" height="500%">
                            <feGaussianBlur stdDeviation="1.8"/>
                        </filter>
                    </defs>
                    <!-- Tia bên trái -->
                    <line x1="200" y1="100" x2="40" y2="40"
                          stroke="url(#rayBurst2)" stroke-width="1.6" filter="url(#rayGlow)"/>
                    <line x1="200" y1="100" x2="30" y2="100"
                          stroke="url(#rayBurst2)" stroke-width="1.2" filter="url(#rayGlow)" opacity="0.7"/>
                    <line x1="200" y1="100" x2="40" y2="160"
                          stroke="url(#rayBurst2)" stroke-width="1.6" filter="url(#rayGlow)"/>
                    <!-- Tia bên phải -->
                    <line x1="200" y1="100" x2="360" y2="40"
                          stroke="url(#rayBurst)" stroke-width="1.6" filter="url(#rayGlow)"/>
                    <line x1="200" y1="100" x2="370" y2="100"
                          stroke="url(#rayBurst)" stroke-width="1.2" filter="url(#rayGlow)" opacity="0.7"/>
                    <line x1="200" y1="100" x2="360" y2="160"
                          stroke="url(#rayBurst)" stroke-width="1.6" filter="url(#rayGlow)"/>
                </svg>
            </span>

            <!-- Nửa trái hình thoi -->
            <span class="half left" aria-hidden="true"></span>

            <!-- Core tia sáng -->
            <span class="prism-core" aria-hidden="true"></span>

            <!-- Nửa phải hình thoi -->
            <span class="half right" aria-hidden="true"></span>

            <!-- LABEL -->
            <span class="btn-label">
                Khám phá
                <span class="glyph" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 2 L22 12 L12 22 L2 12 Z"
                              stroke="#eaf4ff" stroke-width="1.8"
                              stroke-linejoin="round"/>
                        <path d="M12 2 L22 12 L12 22 L2 12 Z" fill="#8ec4ff" opacity="0.3"/>
                    </svg>
                </span>
            </span>
        </button>
    </div>

</body>
</html>