<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FAB + Panel auto-show + Viền sáng xoay</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0;
    min-height: 100vh;
    font-family: "Be Vietnam Pro", system-ui, sans-serif;
    background: #0a0a1a;
    color: #f0ecfa;
    display: grid;
    place-items: center;
    padding: 24px;
    overflow: hidden;
  }

  .demo-hint {
    text-align: center;
    color: #8892b0;
    font-size: 14px;
    line-height: 1.7;
    max-width: 380px;
  }
  .demo-hint strong { color: #e8e0ff; }

  /* ====================================================
     FAB — kéo được + pulse
     ==================================================== */
  .fab {
    position: fixed;
    left: 0; top: 0;
    width: 60px; height: 60px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: 0;
    padding: 0;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #fff;
    cursor: grab;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 8px 24px rgba(37,99,235,.45),
      0 0 0 0    rgba(37,99,235,.55);
    animation: fabPulse 2.6s ease-in-out infinite;
    transition: box-shadow .2s ease, transform .06s linear, opacity .2s ease;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    z-index: 10000;
    will-change: transform;
  }
  .fab svg { width: 30px; height: 30px; pointer-events: none; }
  .fab:hover { box-shadow: 0 12px 28px rgba(37,99,235,.6), 0 0 0 0 rgba(37,99,235,.55); }
  .fab.dragging {
    cursor: grabbing;
    animation: none;
    box-shadow: 0 16px 32px rgba(37,99,235,.65), 0 0 0 8px rgba(37,99,235,.18);
  }
  .fab.is-hidden {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
  }

  @keyframes fabPulse {
    0%,100% { box-shadow: 0 8px 24px rgba(37,99,235,.45), 0 0 0 0   rgba(37,99,235,.55); }
    50%     { box-shadow: 0 8px 24px rgba(37,99,235,.45), 0 0 0 14px rgba(37,99,235,0); }
  }

  /* ====================================================
     PANEL — có viền sáng xoay + hào quang
     ==================================================== */
  .panel {
    position: fixed;
    left: 0; top: 0;
    width: 300px;
    max-width: calc(100vw - 32px);
    display: flex;
    flex-direction: column;
    background: #0f1729;
    color: #e8e0ff;
    border-radius: 16px;

    /* Độ dày viền — PHẢI khớp với inset của ::after */
    padding: 3px;

    /* Hào quang — animation đổi màu */
    animation: glow 4s linear infinite;

    overflow: hidden;                  /* cắt ::before theo bo góc */
    opacity: 0;
    transform: translateY(8px) scale(.96);
    pointer-events: none;
    transition: opacity .25s ease, transform .25s ease;
    z-index: 9999;
    font-family: inherit;
  }
  .panel.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* Dải sáng xoay quanh viền */
  .panel::before {
    content: '';
    position: absolute;
    inset: -50%;                       /* lớn hơn panel để không hở góc khi xoay */
    background: conic-gradient(from 0deg,
        #00ffff, transparent 25%,
        #7a6eff, transparent 60%,
        #ff00e5, transparent 85%,
        #00ffff);
    animation: spin 4s linear infinite;
    z-index: -1;
  }

  /* Lớp che ruột, chừa viền — inset = padding của .panel */
  .panel::after {
    content: '';
    position: absolute;
    inset: 3px;
    background: #0f1729;
    border-radius: 13px;
    z-index: 0;
    pointer-events: none;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Hào quang đổi màu */
  @keyframes glow {
    0%, 100% { box-shadow: 0 0 18px rgba(0,204,238,.7),
                           0 0 36px rgba(0,204,238,.4),
                           0 20px 60px rgba(0,0,0,.55); }
    33%      { box-shadow: 0 0 18px rgba(122,110,255,.7),
                           0 0 36px rgba(122,110,255,.4),
                           0 20px 60px rgba(0,0,0,.55); }
    66%      { box-shadow: 0 0 18px rgba(255,68,238,.7),
                           0 0 36px rgba(255,68,238,.4),
                           0 20px 60px rgba(0,0,0,.55); }
  }

  /* Nội dung nằm trên lớp che */
  .panel-header,
  .panel-body,
  .panel-footer {
    position: relative;
    z-index: 1;
  }

  .panel-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
  }
  .panel-header .avatar {
    width: 26px; height: 26px;
    border-radius: 50%;
    background: rgba(255,255,255,.25);
    display: grid; place-items: center;
    flex-shrink: 0;
  }
  .panel-header .avatar svg { width: 16px; height: 16px; }

  .panel-body {
    padding: 14px;
    font-size: 13.5px;
    line-height: 1.55;
    min-height: 90px;
  }
  .panel-body p { margin: 0 0 8px; }
  .panel-body p:last-child { margin-bottom: 0; }
  .panel-body strong { color: #fff; }

  .panel-footer {
    padding: 10px 14px 14px;
    border-top: 1px solid rgba(255,255,255,.08);
  }
  .panel-close {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 10px;
    background: rgba(255,255,255,.06);
    color: #c8c1de;
    font-family: inherit;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: background .18s ease, color .18s ease,
                border-color .18s ease, transform .18s ease;
  }
  .panel-close:hover {
    background: rgba(239,68,68,.18);
    border-color: rgba(239,68,68,.5);
    color: #ff8f8f;
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
</head>
<body>

<div class="demo-hint">
  <strong>FAB + Panel + Viền sáng xoay</strong><br>
  Vào trang tự mở panel. 3s đóng. 10s mở lại. Click FAB hoặc nút đóng để tắt auto.
</div>

<!-- PANEL -->
<div class="panel" id="panel" role="dialog" aria-label="Trợ lý ảo">
  <div class="panel-header">
    <span class="avatar" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="8" width="16" height="12" rx="3"/>
        <circle cx="9" cy="14" r="1.2" fill="#fff"/>
        <circle cx="15" cy="14" r="1.2" fill="#fff"/>
        <line x1="12" y1="4" x2="12" y2="8"/>
        <circle cx="12" cy="3" r="1"/>
      </svg>
    </span>
    <span>Trợ lý ảo</span>
  </div>

  <div class="panel-body">
    <p><strong>Xin chào bạn 👋</strong></p>
    <p>Bạn có muốn trải nghiệm thử gì đó không?</p>
  </div>

  <div class="panel-footer">
    <button class="panel-close" id="panelClose" type="button">
      ✕ Đóng menu
    </button>
  </div>
</div>

<!-- FAB -->
<button class="fab" id="fab" type="button" aria-label="Mở trợ lý ảo">
  <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"
       stroke-linecap="round" stroke-linejoin="round">
    <rect x="4" y="8" width="16" height="12" rx="3"/>
    <circle cx="9" cy="14" r="1.3" fill="#fff"/>
    <circle cx="15" cy="14" r="1.3" fill="#fff"/>
    <line x1="12" y1="4" x2="12" y2="8"/>
    <circle cx="12" cy="3" r="1"/>
  </svg>
</button>

<script>
(function () {
  const fab   = document.getElementById('fab');
  const panel = document.getElementById('panel');
  const close = document.getElementById('panelClose');

  const FAB_W = 60, FAB_H = 60;
  const GAP = 12, MARGIN = 8, THRESHOLD = 6;
  const STORAGE_KEY = 'fab-pos';

  /* ====================================================
     AUTO-SHOW TIMELINE
     ==================================================== */
  const AUTO_OPEN_DELAY  = 10000;   // 10s — hiện lại
  const AUTO_CLOSE_DELAY = 3000;    //  3s — tự đóng
  let autoMode = true;
  let closeTimer = null;
  let openTimer  = null;

  function scheduleAutoOpen(delay) {
    clearTimeout(openTimer);
    if (!autoMode) return;
    openTimer = setTimeout(() => {
      if (!autoMode) return;
      openPanel();
      scheduleAutoClose();
    }, delay);
  }
  function scheduleAutoClose() {
    clearTimeout(closeTimer);
    if (!autoMode) return;
    closeTimer = setTimeout(() => {
      if (!autoMode) return;
      closePanel();
      scheduleAutoOpen(AUTO_OPEN_DELAY);
    }, AUTO_CLOSE_DELAY);
  }
  function stopAuto() {
    autoMode = false;
    clearTimeout(closeTimer);
    clearTimeout(openTimer);
  }

  /* ====================================================
     VỊ TRÍ FAB + PANEL NEO THEO
     ==================================================== */
  let posX = 0, posY = 0;
  const clamp = (v,min,max) => v < min ? min : (v > max ? max : v);

  function positionPanel() {
    const pw = panel.offsetWidth  || 300;
    const ph = panel.offsetHeight || 200;
    let px = posX + FAB_W - pw;
    let py = posY - ph - GAP;
    if (py < MARGIN) py = posY + FAB_H + GAP;
    if (px + pw > window.innerWidth  - MARGIN) px = window.innerWidth  - pw - MARGIN;
    if (px < MARGIN) px = MARGIN;
    if (py + ph > window.innerHeight - MARGIN) py = window.innerHeight - ph - MARGIN;
    if (py < MARGIN) py = MARGIN;
    panel.style.left = px + 'px';
    panel.style.top  = py + 'px';
  }

  function setPos(x, y) {
    posX = clamp(x, 0, window.innerWidth  - FAB_W);
    posY = clamp(y, 0, window.innerHeight - FAB_H);
    fab.style.transform = `translate(${posX}px, ${posY}px)`;
    positionPanel();
  }

  function initPos() {
    let saved = null;
    try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); } catch (e) {}
    if (saved && typeof saved.x === 'number' && typeof saved.y === 'number') {
      setPos(saved.x, saved.y);
    } else {
      setPos(window.innerWidth - FAB_W - 20, window.innerHeight - FAB_H - 20);
    }
  }

  /* ====================================================
     MỞ / ĐÓNG PANEL
     ==================================================== */
  function openPanel() {
    positionPanel();
    panel.classList.add('open');
    fab.classList.add('is-hidden');
  }
  function closePanel() {
    panel.classList.remove('open');
    fab.classList.remove('is-hidden');
  }

  /* ====================================================
     DRAG FAB
     ==================================================== */
  let dragging = false, pointerId = null, moved = false;
  let startX = 0, startY = 0, baseX = 0, baseY = 0;

  fab.addEventListener('pointerdown', (e) => {
    if (e.button !== 0 && e.pointerType === 'mouse') return;
    dragging = true; moved = false;
    pointerId = e.pointerId;
    startX = e.clientX; startY = e.clientY;
    baseX = posX; baseY = posY;
    try { fab.setPointerCapture(pointerId); } catch (err) {}
    e.preventDefault();
  });

  fab.addEventListener('pointermove', (e) => {
    if (!dragging || e.pointerId !== pointerId) return;
    const dx = e.clientX - startX;
    const dy = e.clientY - startY;
    if (!moved && (Math.abs(dx) > THRESHOLD || Math.abs(dy) > THRESHOLD)) {
      moved = true;
      fab.classList.add('dragging');
    }
    if (moved) setPos(baseX + dx, baseY + dy);
  });

  function endDrag(e) {
    if (!dragging) return;
    if (e && e.pointerId !== pointerId) return;
    dragging = false;
    fab.classList.remove('dragging');
    try { fab.releasePointerCapture(pointerId); } catch (err) {}
    pointerId = null;
    if (moved) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ x: posX, y: posY })); } catch (err) {}
    }
  }
  fab.addEventListener('pointerup', endDrag);
  fab.addEventListener('pointercancel', endDrag);
  fab.addEventListener('lostpointercapture', endDrag);

  /* ====================================================
     CLICK FAB — mở panel + TẮT auto
     ==================================================== */
  fab.addEventListener('click', (e) => {
    if (moved) { e.preventDefault(); e.stopPropagation(); return; }
    stopAuto();
    openPanel();
  });

  /* ====================================================
     CLICK NÚT ĐÓNG — đóng panel + TẮT auto
     ==================================================== */
  close.addEventListener('click', () => {
    stopAuto();
    closePanel();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      stopAuto();
      closePanel();
    }
  });

  window.addEventListener('resize', () => {
    setPos(posX, posY);
    positionPanel();
  });

  /* ====================================================
     KHỞI ĐỘNG
     ==================================================== */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initPos();
      openPanel();
      scheduleAutoClose();
    });
  } else {
    initPos();
    openPanel();
    scheduleAutoClose();
  }
  window.addEventListener('load', positionPanel);
})();
</script>
</body>
</html>