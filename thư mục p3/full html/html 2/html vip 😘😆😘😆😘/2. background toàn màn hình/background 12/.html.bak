<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aurora Ribbons</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    background: radial-gradient(ellipse at 50% 100%, #0a0a24 0%, #050514 60%, #010108 100%);
    display: grid; place-items: center;
    font-family: system-ui, sans-serif;
    color: #eaf2ff; overflow: hidden;
  }
  .glow {
    position: fixed; inset: 0; z-index: -2; pointer-events: none;
    background:
      radial-gradient(ellipse 60% 40% at 50% 0%, rgba(60,200,180,.14), transparent 70%),
      radial-gradient(ellipse 50% 40% at 80% 80%, rgba(180,80,220,.12), transparent 70%);
    filter: blur(60px);
  }
  canvas { position: fixed; inset: 0; z-index: -1; pointer-events: none; display: block; }
  .content { text-align: center; position: relative; z-index: 1; }
  .content h1 {
    font-size: 42px; margin: 0 0 12px; letter-spacing: -.02em;
    background: linear-gradient(135deg, #a8ffe0, #a8c8ff, #d8a8ff);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .content p { color: #9ab0d4; font-size: 15px; }
</style>
</head>
<body>
  <div class="glow" aria-hidden="true"></div>
  <canvas id="c" aria-hidden="true"></canvas>
  <div class="content">
    <h1>Aurora Ribbons</h1>
    <p>Dải cực quang uốn lượn + sao nhỏ phía sau.</p>
  </div>

<script>
(function () {
  const c = document.getElementById('c');
  const ctx = c.getContext('2d');
  if (!ctx) return;

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W = 0, H = 0, dpr = 1, rafId = 0;

  // 3 dải ribbon, mỗi dải có đặc trưng sóng riêng
  let ribbons = [];
  let stars = [];

  function makeRibbon(i) {
    return {
      baseY: H * (0.25 + i * 0.18),        // vị trí dọc cơ bản
      amp1: 40 + Math.random() * 50,       // biên độ sóng 1
      amp2: 20 + Math.random() * 30,       // biên độ sóng 2
      amp3: 10 + Math.random() * 20,       // biên độ sóng 3
      f1: 0.005 + Math.random() * 0.003,   // tần số 1
      f2: 0.012 + Math.random() * 0.005,   // tần số 2
      f3: 0.028 + Math.random() * 0.008,   // tần số 3
      speed: 0.4 + Math.random() * 0.5,
      hue: 150 + i * 60,                    // xanh lá → cyan → tím
      thick: 30 + Math.random() * 40,
      alpha: 0.35 + Math.random() * 0.25,
    };
  }

  function makeStar() {
    return {
      x: Math.random() * W,
      y: Math.random() * H,
      r: 0.4 + Math.random() * 1.2,
      phase: Math.random() * Math.PI * 2,
      speed: 0.5 + Math.random() * 1.5,
    };
  }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth; H = window.innerHeight;
    c.width = W * dpr; c.height = H * dpr;
    c.style.width = W + 'px'; c.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    ribbons = [makeRibbon(0), makeRibbon(1), makeRibbon(2)];

    const starCount = Math.min(180, Math.max(60, Math.floor(W * H / 12000)));
    while (stars.length < starCount) stars.push(makeStar());
    if (stars.length > starCount) stars.length = starCount;
  }

  function drawRibbon(r, t) {
    const tt = t * 0.001 * r.speed;

    // vẽ dải như 1 polygon: trên → phải, dưới → trái
    ctx.beginPath();
    for (let x = -20; x <= W + 20; x += 8) {
      const y = r.baseY
        + Math.sin(x * r.f1 + tt)       * r.amp1
        + Math.sin(x * r.f2 - tt * 1.3) * r.amp2
        + Math.sin(x * r.f3 + tt * 0.7) * r.amp3;
      if (x === -20) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    for (let x = W + 20; x >= -20; x -= 8) {
      const y = r.baseY + r.thick
        + Math.sin(x * r.f1 + tt)       * r.amp1
        + Math.sin(x * r.f2 - tt * 1.3) * r.amp2
        + Math.sin(x * r.f3 + tt * 0.7) * r.amp3;
      ctx.lineTo(x, y);
    }
    ctx.closePath();

    // gradient dọc ribbon: mờ ở đỉnh, đậm ở dưới
    const grad = ctx.createLinearGradient(0, r.baseY - r.amp1, 0, r.baseY + r.thick + r.amp1);
    grad.addColorStop(0,   'hsla(' + r.hue + ', 90%, 65%, 0)');
    grad.addColorStop(0.4, 'hsla(' + r.hue + ', 90%, 65%, ' + r.alpha + ')');
    grad.addColorStop(1,   'hsla(' + r.hue + ', 90%, 65%, 0)');
    ctx.fillStyle = grad;
    ctx.globalCompositeOperation = 'screen';
    ctx.fill();
    ctx.globalCompositeOperation = 'source-over';
  }

  function draw(t) {
    ctx.clearRect(0, 0, W, H);

    // sao nền
    for (const s of stars) {
      const a = 0.4 + 0.6 * Math.abs(Math.sin(t * 0.001 * s.speed + s.phase));
      ctx.fillStyle = 'rgba(220,235,255,' + a.toFixed(3) + ')';
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
    }

    // ribbon
    for (const r of ribbons) drawRibbon(r, t);

    rafId = requestAnimationFrame(draw);
  }

  function start() { if (!rafId && !reduceMotion) rafId = requestAnimationFrame(draw); }
  function stop()  { if (rafId) { cancelAnimationFrame(rafId); rafId = 0; } }

  window.addEventListener('resize', resize, { passive: true });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop(); else start();
  });

  resize();
  start();
})();
</script>
</body>
</html>