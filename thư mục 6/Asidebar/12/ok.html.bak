<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chiến Tranh & Hòa Bình — Nhịp Đập Của Sự Sống</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;500;700&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  :root{
    /* Chiến tranh */
    --war-bg: #121212;
    --war-ink: #e0e0e0;
    --war-ash: #4a4a4a;
    --war-red: #8b1c1c;
    
    /* Hòa bình */
    --peace-bg: #f4f1ea;
    --peace-ink: #2e3a2c;
    --peace-green: #4a6b53;
    --peace-earth: #c4b5a0;
    
    --font-war:'Oswald', sans-serif;
    --font-peace:'Lora', Georgia, serif;
  }
  
  html,body{height:100%;overflow:hidden;background:var(--peace-bg);color:var(--peace-ink);}
  
  /* Texture nền: Bê tông nứt (Trái) / Giấy cũ (Phải) */
  .texture-overlay{
    position:fixed;inset:0;pointer-events:none;z-index:10;display:flex;
  }
  .tex-war{
    flex:1;opacity:.15;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    mix-blend-mode:overlay;
  }
  .tex-peace{
    flex:1;opacity:.4;
    background-image:radial-gradient(rgba(0,0,0,0.05) 1px, transparent 1px);
    background-size:4px 4px;
  }

  .stage{position:relative;width:100vw;height:100vh;overflow:hidden;z-index:1;}

  /* Đường phân cách dọc */
  .split-line{
    position:absolute;top:0;bottom:0;left:50%;width:2px;
    background:linear-gradient(to bottom, transparent, #999, transparent);
    z-index:5;transform:translateX(-50%);
  }

  /* Slides */
  .slides{position:relative;width:100%;height:100%;}
  .slide{
    position:absolute;inset:0;display:flex;flex-direction:column;
    padding:clamp(24px,4.5vw,60px) clamp(20px,5vw,70px) clamp(80px,12vh,110px);
    opacity:0;visibility:hidden;
    transition:opacity 1s ease,visibility 0s 1s;
  }
  .slide.active{opacity:1;visibility:visible;transition:opacity 1s ease,visibility 0s 0s;}

  /* Fade Reveal (Giữ nguyên) */
  .reveal{opacity:0;transition:opacity 1.1s ease;}
  .slide.active .reveal{opacity:1;}
  .slide.active .d1{transition-delay:.15s;}
  .slide.active .d2{transition-delay:.32s;}
  .slide.active .d3{transition-delay:.5s;}
  .slide.active .d4{transition-delay:.68s;}
  .slide.active .d5{transition-delay:.86s;}

  /* ============ SLIDE 1: COVER ============ */
  .cover{justify-content:center;align-items:center;text-align:center;position:relative;background:var(--peace-bg);}
  
  .cover .bg-half{
    position:absolute;top:0;bottom:0;width:50%;z-index:-1;
  }
  .cover .bg-half.left{left:0;background:var(--war-bg);}
  .cover .bg-half.right{right:0;background:var(--peace-bg);}

  .cover .content{
    position:relative;z-index:2;width:100%;max-width:900px;padding:0 20px;
  }
  
  .cover h1{
    font-family:var(--font-war);font-weight:700;font-size:clamp(40px,10vw,110px);
    line-height:.9;text-transform:uppercase;letter-spacing:.02em;mix-blend-mode:difference;color:#fff;
  }
  .cover h1 span{
    display:block;font-family:var(--font-peace);font-style:italic;font-size:.6em;
    text-transform:none;font-weight:400;color:var(--peace-green);margin-top:10px;letter-spacing:0;
  }
  
  .cover .subtitle{
    margin-top:30px;font-size:clamp(14px,1.6vw,18px);line-height:1.6;color:var(--peace-ink);font-family:var(--font-peace);
  }

  /* ============ SLIDE 2: HAI THẾ GIỚI ============ */
  .worlds{display:flex;width:100%;height:100%;align-items:stretch;}
  
  .world-half{
    flex:1;display:flex;flex-direction:column;justify-content:center;padding:5%;
  }
  .world-half.war{background:var(--war-bg);color:var(--war-ink);text-align:right;padding-right:8%;}
  .world-half.peace{background:var(--peace-bg);color:var(--peace-ink);text-align:left;padding-left:8%;}

  .world-half .tag{
    font-size:clamp(10px,1.2vw,14px);letter-spacing:.3em;text-transform:uppercase;margin-bottom:15px;opacity:.6;
  }
  .world-half.war .tag{font-family:var(--font-war);}
  .world-half.peace .tag{font-family:var(--font-peace);font-style:italic;}

  .world-half h2{
    font-size:clamp(32px,5vw,60px);line-height:1.1;margin-bottom:20px;
  }
  .world-half.war h2{font-family:var(--font-war);text-transform:uppercase;color:var(--war-red);}
  .world-half.peace h2{font-family:var(--font-peace);color:var(--peace-green);font-weight:600;}
  
  .world-half p{
    font-size:clamp(13px,1.5vw,17px);line-height:1.7;max-width:35ch;
  }
  .world-half.war p{font-family:var(--font-war);font-weight:300;margin-left:auto;}
  .world-half.peace p{font-family:var(--font-peace);}

  /* ============ SLIDE 3: VẾT SẸO (Split Details) ============ */
  .scars{display:grid;grid-template-columns:1fr 1fr;width:100%;height:100%;gap:40px;}
  
  .scar-col{display:flex;flex-direction:column;justify-content:center;}
  .scar-col.war{text-align:right;align-items:flex-end;}
  .scar-col.peace{text-align:left;align-items:flex-start;}

  .scar-item{margin-bottom:30px;position:relative;}
  .scar-item .num{
    font-size:clamp(30px,4vw,50px);font-weight:700;line-height:1;margin-bottom:5px;
  }
  .scar-col.war .num{font-family:var(--font-war);color:var(--war-red);}
  .scar-col.peace .num{font-family:var(--font-peace);color:var(--peace-green);font-style:italic;}

  .scar-item h3{font-size:clamp(16px,1.8vw,22px);margin-bottom:8px;}
  .scar-col.war h3{font-family:var(--font-war);text-transform:uppercase;letter-spacing:.05em;}
  .scar-col.peace h3{font-family:var(--font-peace);font-weight:600;}

  .scar-item p{font-size:clamp(12px,1.3vw,15px);line-height:1.6;max-width:40ch;}
  .scar-col.war p{font-family:var(--font-war);font-weight:300;color:#aaa;}
  .scar-col.peace p{font-family:var(--font-peace);color:#555;}

  /* ============ SLIDE 4: LỜI KẾT (Typographic Center) ============ */
  .message{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;width:100%;height:100%;}
  
  .message .quote{
    font-family:var(--font-peace);font-size:clamp(24px,4vw,48px);line-height:1.4;font-style:italic;
    color:var(--peace-ink);max-width:25ch;margin-bottom:30px;
  }
  .message .quote b{color:var(--peace-green);font-weight:600;}
  
  .message .author{
    font-family:var(--font-war);font-size:clamp(12px,1.5vw,16px);letter-spacing:.3em;text-transform:uppercase;color:#888;
  }

  /* ============ SLIDE 5: FINAL ============ */
  .final{justify-content:center;align-items:center;text-align:center;background:var(--war-bg);color:var(--war-ink);}
  .final h1{
    font-family:var(--font-war);font-size:clamp(40px,8vw,100px);text-transform:uppercase;line-height:1;
    color:var(--peace-bg);margin-bottom:20px;
  }
  .final h1 span{color:var(--war-red);}
  .final p{
    font-family:var(--font-peace);font-size:clamp(14px,1.6vw,20px);color:#888;max-width:50ch;line-height:1.6;
  }

  /* ============ NAVIGATION BAR ============ */
  .nav-bar{
    position:absolute;left:0;right:0;bottom:0;z-index:30;
    padding:0 clamp(20px,4.5vw,64px) clamp(16px,3vh,30px);
    display:flex;align-items:center;justify-content:space-between;gap:16px;
    pointer-events:none;
    background:linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 100%);
  }
  .nav-bar > *{pointer-events:auto;}
  
  /* (1) Bộ đếm trang */
  .page-counter{
    font-family:var(--font-war);font-size:clamp(14px,1.8vw,18px);
    letter-spacing:.1em;color:#fff;white-space:nowrap;
  }
  .page-counter b{color:var(--peace-earth);}
  
  /* (2) Thanh tiến trình */
  .progress-bar{
    flex:1;max-width:400px;height:2px;background:rgba(255,255,255,0.2);
    position:relative;overflow:hidden;
  }
  .progress-fill{
    height:100%;width:0%;background:var(--war-red);
    transition:width .6s cubic-bezier(.4,0,.2,1);
  }

  /* (3) Cặp nút < > */
  .nav-btns{display:flex;gap:15px;}
  .nav-btn{
    width:clamp(40px,4.5vw,48px);height:clamp(40px,4.5vw,48px);
    background:transparent;border:1px solid rgba(255,255,255,0.3);color:#fff;
    display:flex;align-items:center;justify-content:center;cursor:pointer;
    transition:all .3s ease;
  }
  .nav-btn:hover:not(:disabled){background:#fff;color:#000;border-color:#fff;}
  .nav-btn:active:not(:disabled){transform:scale(.95);}
  .nav-btn svg{width:40%;height:40%;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:square;}
  .nav-btn:disabled{opacity:.3;cursor:not-allowed;}

  /* ============ RESPONSIVE ============ */
  @media (max-width:880px){
    .worlds{flex-direction:column;}
    .world-half.war{text-align:left;padding:30px 20px;align-items:flex-start;}
    .world-half.war p{margin-left:0;}
    .world-half.peace{padding:30px 20px;}
    .scars{grid-template-columns:1fr;gap:20px;}
    .scar-col.war{text-align:left;align-items:flex-start;border-bottom:1px solid #ccc;padding-bottom:20px;}
    .scar-col.peace{text-align:left;align-items:flex-start;}
    .split-line{display:none;}
    .cover .bg-half.left{width:100%;height:50%;bottom:auto;}
    .cover .bg-half.right{width:100%;height:50%;top:auto;}
    .cover h1{color:#fff;}
  }
  @media (max-width:560px){
    .slide{padding:20px 16px 90px;}
    .cover h1{font-size:36px;}
    .nav-bar{padding:0 16px 16px;}
    .progress-bar{max-width:80px;}
  }
</style>
</head>
<body>

<div class="texture-overlay">
  <div class="tex-war"></div>
  <div class="tex-peace"></div>
</div>

<div class="stage">
  <div class="split-line"></div>

  <div class="slides" id="slides">

    <!-- SLIDE 1: COVER -->
    <section class="slide cover active" data-i="0">
      <div class="bg-half left"></div>
      <div class="bg-half right"></div>
      <div class="content">
        <h1 class="reveal d1">
          Chiến Tranh
          <span>& Hòa Bình</span>
        </h1>
        <p class="subtitle reveal d3">Nhịp đập của sự sống nằm giữa ranh giới mong manh của sự tàn phá và hồi sinh.</p>
      </div>
    </section>

    <!-- SLIDE 2: HAI THẾ GIỚI -->
    <section class="slide" data-i="1">
      <div class="body" style="height:100%;margin:0;padding:0;overflow:hidden;">
        <div class="worlds">
          <!-- Chiến tranh -->
          <div class="world-half war">
            <div class="tag reveal d1">Bóng tối</div>
            <h2 class="reveal d2">Sự Tàn Phá</h2>
            <p class="reveal d3">Chiến tranh không chỉ lấy đi sinh mạng, mà còn xóa sổ những giấc mơ, chia cắt những gia đình và để lại những vết sẹo không bao giờ lành trong tâm hồn con người.</p>
          </div>
          
          <!-- Hòa bình -->
          <div class="world-half peace">
            <div class="tag reveal d1">Ánh sáng</div>
            <h2 class="reveal d2">Sự Hồi Sinh</h2>
            <p class="reveal d3">Hòa bình không chỉ là sự vắng bóng của tiếng súng. Đó là khi trẻ em được đến trường, những cánh đồng lại nở hoa, và con người được sống là chính mình.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SLIDE 3: VẾT SẸO -->
    <section class="slide" data-i="2">
      <div class="head reveal d1" style="text-align:center;margin-bottom:20px;">
        <h2 style="font-family:var(--font-war);text-transform:uppercase;letter-spacing:.2em;">Hai mặt của một đồng xu</h2>
      </div>
      <div class="body">
        <div class="scars">
          <!-- Cột Chiến Tranh -->
          <div class="scar-col war">
            <div class="scar-item reveal d2">
              <div class="num">-70%</div>
              <h3>Kinh tế sụp đổ</h3>
              <p>Cơ sở hạ tầng bị phá hủy, nghèo đói và dịch bệnh lan tràn.</p>
            </div>
            <div class="scar-item reveal d3">
              <div class="num">Vô hình</div>
              <h3>Chấn thương tâm lý</h3>
              <p>Hội chứng PTSD (Rối loạn căng thẳng sau sang chấn) ám ảnh nhiều thế hệ.</p>
            </div>
          </div>
          
          <!-- Cột Hòa Bình -->
          <div class="scar-col peace">
            <div class="scar-item reveal d4">
              <div class="num">+100%</div>
              <h3>Cơ hội phát triển</h3>
              <p>Giáo dục, y tế và văn hóa được phục hồi và phát triển mạnh mẽ.</p>
            </div>
            <div class="scar-item reveal d5">
              <div class="num">Hữu hình</div>
              <h3>Kết nối cộng đồng</h3>
              <p>Con người xích lại gần nhau, cùng xây dựng một tương lai tốt đẹp hơn.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SLIDE 4: LỜI KẾT -->
    <section class="slide" data-i="3">
      <div class="body" style="background:var(--peace-bg);">
        <div class="message">
          <div class="quote reveal d2">
            "Chúng ta không thể chấm dứt chiến tranh bằng cách <b>nói về chiến tranh</b>. Chúng ta chấm dứt nó bằng cách xây dựng hòa bình."
          </div>
          <div class="author reveal d4">Tư tưởng vì hòa bình</div>
        </div>
      </div>
    </section>

    <!-- SLIDE 5: FINAL -->
    <section class="slide final" data-i="4">
      <h1 class="reveal d1">Hãy chọn <span>Hòa Bình</span></h1>
      <p class="reveal d3">Bởi lẽ, chiến thắng vĩ đại nhất không phải là chiến thắng kẻ thù, mà là chiến thắng chính bản thân mình để không gieo rắc nỗi đau.</p>
    </section>

  </div>

  <!-- ============ NAVIGATION BAR ============ -->
  <div class="nav-bar">
    <!-- (1) Bộ đếm trang -->
    <div class="page-counter" id="counter">
      <b>01</b> / 05
    </div>
    
    <!-- (2) Thanh tiến trình -->
    <div class="progress-bar">
      <div class="progress-fill" id="progress"></div>
    </div>
    
    <!-- (3) Cặp nút < > -->
    <div class="nav-btns">
      <button class="nav-btn" id="prev" aria-label="Slide trước">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="nav-btn" id="next" aria-label="Slide tiếp">
        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>

</div>

<script>
(function(){
  const slides = Array.from(document.querySelectorAll('.slide'));
  const total = slides.length;
  const prevBtn = document.getElementById('prev');
  const nextBtn = document.getElementById('next');
  const counter = document.getElementById('counter');
  const progress = document.getElementById('progress');
  let current = 0;
  let animating = false;

  function pad(n){ return String(n+1).padStart(2,'0'); }

  function update(){
    counter.innerHTML = '<b>'+pad(current)+'</b> / '+String(total).padStart(2,'0');
    progress.style.width = ((current+1)/total*100)+'%';
    prevBtn.disabled = current===0;
    nextBtn.disabled = current===total-1;
  }

  function go(i){
    if(animating || i===current || i<0 || i>=total) return;
    animating = true;
    const outgoing = slides[current];
    const incoming = slides[i];
    outgoing.classList.remove('active');
    setTimeout(()=>{
      incoming.classList.add('active');
      current = i;
      update();
      setTimeout(()=>{ animating = false; }, 900);
    }, 500);
  }

  prevBtn.addEventListener('click', ()=> go(current-1));
  nextBtn.addEventListener('click', ()=> go(current+1));

  document.addEventListener('keydown', e=>{
    if(e.key==='ArrowRight'||e.key===' '||e.key==='PageDown'){ e.preventDefault(); go(current+1); }
    if(e.key==='ArrowLeft'||e.key==='PageUp'){ e.preventDefault(); go(current-1); }
    if(e.key==='Home'){ e.preventDefault(); go(0); }
    if(e.key==='End'){ e.preventDefault(); go(total-1); }
  });

  let sx=0, sy=0, tracking=false;
  const stage = document.querySelector('.stage');
  stage.addEventListener('touchstart', e=>{
    if(e.touches.length!==1) return;
    sx = e.touches[0].clientX; sy = e.touches[0].clientY; tracking=true;
  }, {passive:true});
  stage.addEventListener('touchend', e=>{
    if(!tracking) return; tracking=false;
    const dx = e.changedTouches[0].clientX - sx;
    const dy = e.changedTouches[0].clientY - sy;
    if(Math.abs(dx)>50 && Math.abs(dx)>Math.abs(dy)){
      if(dx<0) go(current+1); else go(current-1);
    }
  }, {passive:true});

  update();
})();
</script>
</body>
</html>