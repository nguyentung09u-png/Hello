<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tình Yêu — Bài Thuyết Trình 3 Phút</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --kem:#F8F1EA;
    --do:#7B2D3B;
    --do-dam:#5A1F2A;
    --gold:#C9A227;
    --than:#2B2B2B;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{height:100%;overflow:hidden;background:var(--kem);}
  body{font-family:'Montserrat',sans-serif;color:var(--than);}

  .deck{position:relative;width:100vw;height:100vh;}

  .slide{
    position:absolute;inset:0;
    display:flex;flex-direction:column;
    justify-content:center;align-items:center;
    padding:6vh 8vw;
    opacity:0;visibility:hidden;
    transition:opacity .6s ease, visibility .6s;
    background:var(--kem);
  }
  .slide.active{opacity:1;visibility:visible;}

  h1,h2{font-family:'Playfair Display',serif;color:var(--do);line-height:1.15;}
  .gold-line{width:90px;height:3px;background:var(--gold);border-radius:2px;margin:22px auto;}

  /* Slide 1 */
  .cover{background:
    linear-gradient(rgba(248,241,234,.55),rgba(248,241,234,.75)),
    url('images/cover.jpg') center/cover no-repeat,
    var(--kem);
    text-align:center;}
  .cover h1{font-size:clamp(48px,9vw,110px);letter-spacing:4px;}
  .cover p